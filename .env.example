# PostgreSQL — Neon
# DATABASE_URL = pooled (app/runtime)
# DIRECT_URL = non-pooled (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Cron authentication (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="replace-with-a-long-random-string"

# Resend email delivery (https://resend.com)
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="UniFeeWise <onboarding@resend.dev>"

# Meta Lead Ads webhook verification + Graph API access
META_VERIFY_TOKEN="replace-with-your-verify-token"
META_ACCESS_TOKEN="EAAxxxxxxxx"

# WhatsApp Cloud API
WHATSAPP_TOKEN="EAAxxxxxxxx"
WHATSAPP_PHONE_ID="1234567890"
WHATSAPP_BUSINESS_ACCOUNT_ID="1234567890"
